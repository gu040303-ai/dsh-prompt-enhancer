{
  "name": "dsh-prompt-enhancer",
  "version": "0.4.2",
  "description": "One-click plain-text prompt enhancement and optional sentence review in DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/types/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "VALIDATION.md",
    "CHANGELOG.md",
    "CLAIMS.md",
    "RELEASE.md",
    "LICENSE",
    "assets",
    "screenshots.json"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:feedback": "node scripts/feedback-smoke.mjs",
    "test:compat": "node scripts/check-harness-boot.mjs --browser",
    "test:installed": "node scripts/test-installed.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "prepack": "npm run check"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remote-access": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "@lexical/history": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.0",
    "immer": "^11.2.6",
    "jsdom": "^26.0.0",
    "lexical": "^0.49.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "zustand": "^5.0.15",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gu040303-ai/dsh-prompt-enhancer.git"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-working-directory": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    }
  }
}
